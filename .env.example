# Copy to .env and fill in real values. .env is git-ignored — never commit real keys.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override default model ids
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=

# Optional: path overrides (defaults live in ier/config.py)
IER_DATA_ROOT=./data/provided
IER_CACHE_ROOT=./cache
IER_OUTPUT_ROOT=./outputs
